# --- Yerel LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT_MS=45000

# --- Canlı uçuş fiyatları (Travelpayouts / Aviasales) ---
# Token'ı https://www.travelpayouts.com/ hesabına kaydolup
# Profil > API token bölümünden alacaksın. Boş bırakırsan uygulama
# çalışmaya devam eder, sadece fiyatlar tahmini olur.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_CURRENCY=try
TRAVELPAYOUTS_TIMEOUT_MS=8000
TRAVELPAYOUTS_CACHE_TTL_MS=1800000

# Kalkış havalimanı (IATA kodu)
ORIGIN_IATA=IST

# Canlı destinasyon listesi
CATALOG_SIZE=18
CATALOG_TTL_MS=1800000
DEFAULT_HOTEL_PRICE=2800
TRAVELPAYOUTS_LOCALE=tr

# Zaman aşımları (ms). Referans veri dosyaları büyüktür; ilk indirmeden sonra
# data/city-index.json'a yazılır ve tekrar indirilmez.
TRAVELPAYOUTS_DIRECTIONS_TIMEOUT_MS=30000
TRAVELPAYOUTS_REF_TIMEOUT_MS=120000
